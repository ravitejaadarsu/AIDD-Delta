{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIDD Delta per-change state (.aidd/changes/<id>/state.yaml)",
  "type": "object",
  "required": ["schema", "change_id", "intent", "mode", "phase", "phase_status"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "enum": [1] },
    "change_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
    "intent": { "type": "string" },
    "mode": { "enum": ["take-care", "let-me-look"] },
    "rigor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selected_by"],
      "properties": {
        "mode": { "enum": ["fast", "standard", "critical"] },
        "selected_by": { "enum": ["classifier", "user", "escalation"] },
        "reason": { "type": ["string", "null"] },
        "escalations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "trigger", "at"],
            "additionalProperties": false,
            "properties": {
              "from": { "enum": ["fast", "standard", "critical"] },
              "to": { "enum": ["fast", "standard", "critical"] },
              "trigger": { "type": "string" },
              "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
            }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_tokens": { "type": "integer", "minimum": 0 },
        "budget_minutes": { "type": "integer", "minimum": 0 },
        "spent_tokens": { "type": "integer", "minimum": 0 },
        "spent_minutes": { "type": "integer", "minimum": 0 },
        "by_phase": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["tokens", "minutes"],
            "additionalProperties": false,
            "properties": {
              "tokens": { "type": "integer", "minimum": 0 },
              "minutes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "projection_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "stops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "phase", "reason", "disposition"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
              "phase": { "enum": ["document", "master", "inception", "construction", "qa", "delivery", "retro"] },
              "reason": { "type": "string" },
              "disposition": { "enum": ["raised", "reduced-breadth", "narrowed-scope", "aborted", "aborted-dispatch", "pending"] }
            }
          }
        }
      }
    },
    "phase": { "enum": ["document", "master", "inception", "construction", "qa", "delivery", "retro", "done"] },
    "phase_status": { "enum": ["not_started", "in_progress", "awaiting_gate", "blocked", "complete"] },
    "step": { "type": ["string", "null"] },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticket": { "type": ["string", "null"] },
        "sync": { "type": "boolean" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["pending", "awaiting", "approved", "revised", "stale", "aborted"] },
          "artifact": { "type": ["string", "null"] },
          "artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8,64}$" },
          "approved_by": { "enum": ["human", "auto", null] },
          "at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_green": { "enum": ["pending", "passed", "failed", "na"] },
        "exhaustive_tests_passed": { "enum": ["pending", "passed", "failed", "na"] },
        "qa_findings_resolved": { "enum": ["pending", "passed", "failed", "na"] },
        "e2e_verified": { "enum": ["pending", "passed", "failed", "na"] },
        "mutation_floor_met": { "enum": ["pending", "passed", "failed", "na"] },
        "security_clean": { "enum": ["pending", "passed", "failed", "na"] },
        "perf_within_budget": { "enum": ["pending", "passed", "failed", "na"] },
        "acs_verified": { "enum": ["pending", "passed", "failed", "na"] },
        "evidence_captured": { "enum": ["pending", "passed", "failed", "na"] },
        "supervision_compliant": { "enum": ["pending", "passed", "failed", "na"] },
        "critic_approved": { "enum": ["pending", "passed", "failed", "na"] },
        "auditor_approved": { "enum": ["pending", "passed", "failed", "na"] },
        "debate_complete": { "enum": ["pending", "passed", "failed", "na"] },
        "tally_reconciled": { "enum": ["pending", "passed", "failed", "na"] },
        "within_cost_budget": { "enum": ["pending", "passed", "failed", "na"] }
      }
    },
    "stories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["queued", "ready", "in_progress", "built", "blocked", "failed", "done"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "wave": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "fix_loop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iteration": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "backflow_used": { "type": "boolean" },
    "supervision": {
      "type": "object",
      "additionalProperties": { "enum": ["pending", "compliant", "violations"] }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "verdict": { "enum": ["PASS", "CONCERNS", "FAIL"] },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interrogation": { "type": "object", "additionalProperties": false,
          "properties": { "rounds_used": {"type":"integer","minimum":0}, "max": {"type":"integer","minimum":1} },
          "required": ["rounds_used","max"] },
        "negotiation":   { "type": "object", "additionalProperties": false,
          "properties": {
            "exchanges_used": {"type":"integer","minimum":0},
            "max": {"type":"integer","minimum":1},
            "rulings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ac_id", "ruling", "ruled_by"],
                "additionalProperties": false,
                "properties": {
                  "ac_id": { "type": "string" },
                  "ruling": { "enum": ["PROVEN", "DEFECT", "UNRESOLVABLE"] },
                  "ruled_by": { "enum": ["negotiation", "Supervisor adjudication", "short-circuit", "short-circuit (no monitoring note)"] }
                }
              }
            }
          },
          "required": ["exchanges_used","max"] },
        "debate":        { "type": "object", "additionalProperties": false,
          "properties": { "exchanges_used": {"type":"integer","minimum":0}, "max": {"type":"integer","minimum":1} },
          "required": ["exchanges_used","max"] }
      },
      "required": ["interrogation","negotiation","debate"]
    },
    "escapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "at", "defect_class", "verdict"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^E-[0-9]{3}$" },
          "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "defect_class": { "enum": ["auth-bypass", "tenant-leak", "off-by-one", "race", "silent-catch", "mocked-proof", "missing-ac-coverage", "perf-regression", "contract-break", "migration-data-loss", "secret-leak", "logic-inversion", "orphan-diff", "process-skip"] },
          "verdict": { "enum": ["layer-blind", "no-layer-at-reasonable-cost", "out-of-scope"] },
          "blind_layers": {
            "type": "array",
            "items": { "enum": ["L1-review", "L1-tests", "L2-auditor", "L2-tally", "L2-debate", "L3-supervisor", "critic", "e2e-mutation", "evidence-capture"] }
          },
          "regression_test": { "type": ["string", "null"] },
          "amendment": { "type": ["string", "null"] },
          "report": { "type": ["string", "null"] },
          "repeat_of": { "type": ["string", "null"] }
        }
      }
    },
    "blocked_reason": { "type": ["string", "null"] },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "event"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "event": { "type": "string" }
        }
      }
    },
    "updated_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
